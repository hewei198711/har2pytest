{
    "BASE_URLS": [
        "https://api.example.com"
    ],
    "KILL_URLS": [
        ".js",
        ".css",
        ".png",
        ".jpg",
        ".gif",
        ".ico",
        ".svg",
        ".woff",
        ".woff2",
        ".ttf",
        ".eot"
    ],
    "DEFAULT_API_DIR": "apis",
    "TESTCASE_DIR": "testcases",
    "SERVICE_MAPPING": {
        "mobile": "mobile_application",
        "invt": "inventory_application",
        "mgmt": "management_application"
    },
    "SWAGGER_DOC_URLS": {
        "mobile_application": "https://api.example.com/mobile/v2/api-docs",
        "inventory_application": "https://api.example.com/invt/v2/api-docs"
    },
    "HEADERS_TO_INCLUDE": {
        "authorization": "f\"bearer {os.environ.get('token', '')}\"",
        "content-type": "application/json;charset=UTF-8"
    },
    "REQUIRED_HEADERS": {
        "authorization": "f\"bearer {os.environ.get('token', '')}\""
    },
    "INVALID_PARAMS": [
        "rnd",
        "timestamp",
        "_",
        "t",
        "callback",
        "jsonp"
    ],
    "PAGINATION_PARAMS": {
        "pageNum": 1,
        "pageSize": 10
    },
    "LIST_QUERY_KEYWORDS": [
        "列表"
    ],
    "LIST_QUERY_EXCLUDE_KEYWORDS": [
        "详情",
        "导出",
        "下载"
    ],
    "TESTCASE_PROFILES": [
        { "url": "/demo/order/List", "mode": "list_query" },
        { "url": "/demo/order/{orderNo}", "mode": "complex_scenario" },
        { "url": "/demo/order/*", "mode": "auto", "keywords": ["列表"], "exclude_keywords": ["详情"] }
    ],
    "STATE_VALUE_PATTERNS": [
        "(-?\\d+)\\s*[:：]",
        {
            "regex": "(\\w+)\\s*->",
            "type": "str"
        }
    ],
    "PATH_URLS": [
        "/order/demoAction/{id}",
        "/order/{orderId}/detail"
    ],
    "TRACK_PARAM_SOURCES": true,
    "PARAM_SOURCE_MIN_LENGTH": 4,
    "PARAM_SOURCE_IGNORE_KEYS": [
        "sign",
        "timestamp"
    ],
    "COLLECT_RESPONSE_APIS": [
        {
            "url": "/upload",
            "collect_key": "upload",
            "files_key": "files",
            "file_field": "file",
            "append_path": ["datas"]
        }
    ],
    "DB_CONFIG": {
        "host": "demo.mysql.example.com",
        "port": 3306,
        "user": "tester",
        "password_env": "TEST_DB_PWD",
        "databases": [
            "demo_center_member",
            "demo_center_store",
            "demo_center_order",
            "demo_center_promotion"
        ],
        "domain_schemas": {
            "member": {
                "schemas": ["demo_center_member"],
                "url": ["member", "vip", "card"],
                "cn": ["会员", "顾客", "客户"]
            },
            "store": {
                "schemas": ["demo_center_store"],
                "url": ["store"],
                "cn": ["门店", "店铺", "服务中心"]
            },
            "order": {
                "schemas": ["demo_center_order"],
                "url": ["order", "refund", "return", "exchange"],
                "cn": ["订单", "售后", "退货", "退款", "换货"]
            },
            "promotion": {
                "schemas": ["demo_center_promotion"],
                "url": ["promotion", "combine", "coupon", "activity"],
                "cn": ["活动", "促销", "优惠券"]
            }
        },
        "preferred_tables": [
            "demo_center_order.demo_member",
            "demo_center_order.demo_product"
        ],
        "api_table_map": {
            "/demo/demoReview/demoAction": {
                "table": "demo_center_order.demo_review_record",
                "where": "demo_visit_status = 0"
            },
            "/demo/order/demoDetail": "demo_center_order.demo_order_info"
        }
    }
}